# ==============================================================================
# Foliovera (Repository: EthicalMaster/FOLIOVERA) — Environment Configuration
# All credentials are kept STRICTLY server-side. Never prefix secrets with VITE_.
# ==============================================================================

# AI / LLM Configuration
# GEMINI_API_KEY: Required for Gemini AI resume tailoring when configured.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
# APP_URL: Injected automatically by AI Studio / Cloud Run at runtime.
APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
PORT="3000"

# ==============================================================================
# Phase 1.5 — Firebase Authentication & Owner Authorization Policy
# ==============================================================================
# Single-user MVP owner restriction. At least one of FOLIOVERA_OWNER_UID or
# FOLIOVERA_OWNER_EMAIL must be configured; if omitted, defaults to the
# provisioned owner email and fails closed on non-owner accounts.
FOLIOVERA_OWNER_EMAIL="saifeetaher5@gmail.com"
FOLIOVERA_OWNER_UID=""

# Optional Firebase Project overrides (defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID="tribal-transformer-2lxdt"
FIRESTORE_DATABASE_ID="ai-studio-livingresumeagen-782346cd-b534-4b21-898d-4ccf402003ee"

# Optional Service Account JSON for Admin SDK in custom self-hosted environments
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ==============================================================================
# Persistent Storage Layer Configuration
# ==============================================================================
# STORAGE_DRIVER options:
#   - 'firestore' (production default when Firebase is provisioned): Durable Cloud Firestore
#   - 'sqlite': Local on-disk SQLite database using Node 22 native node:sqlite
#   - 'in-memory': Ephemeral in-memory store (used only for isolated unit tests)
STORAGE_DRIVER="firestore"
SQLITE_DB_PATH="./data/living-resume.sqlite"

# ==============================================================================
# GitHub API Integration (Official GitHub REST API)
# ==============================================================================
# GITHUB_TOKEN: Optional for public repository discovery (60 requests/hr unauthenticated).
# Fine-grained Personal Access Token (read-only public metadata) raises rate limit to 5,000 requests/hr.
# Strictly server-side only. Never exposed to the browser.
GITHUB_TOKEN=""

# ==============================================================================
# Security & Data Sanitization
# ==============================================================================
STRICT_INJECTION_SCANNING="true"
MAX_UNTRUSTED_CONTENT_BYTES="32768"
