# ==============================================================================
# Foliovera (formerly Living Resume Agent) — Environment Configuration
# All credentials are kept STRICTLY server-side. Never prefix secrets with VITE_.
# Free-tier friendly: operates with unauthenticated GitHub API & local SQLite.
# ==============================================================================

# AI / LLM Configuration
# GEMINI_API_KEY: Optional for deterministic GitHub sync; used for AI resume tailoring when configured.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
# APP_URL: Injected automatically by AI Studio at runtime.
APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
PORT="3000"

# Persistent Storage Layer Configuration
# STORAGE_DRIVER options:
#   - 'sqlite' (default): Persistent on-disk SQLite database using Node 22 native node:sqlite
#   - 'in-memory': Ephemeral in-memory store (used only for isolated unit tests)
STORAGE_DRIVER="sqlite"
SQLITE_DB_PATH="./data/living-resume.sqlite"

# GitHub API Integration (Official GitHub REST API)
# GITHUB_TOKEN: Optional for public repository discovery (60 requests/hr unauthenticated).
# Fine-grained Personal Access Token (read-only public metadata) raises rate limit to 5,000 requests/hr.
# Strictly server-side only. Never exposed to the browser.
GITHUB_TOKEN=""

# Security & Data Sanitization
# Controls whether incoming repository content is strictly quarantined and scanned for prompt injection
STRICT_INJECTION_SCANNING="true"
MAX_UNTRUSTED_CONTENT_BYTES="32768"
